# =============================================================================
# 浅雾羽依（QianWuYuyi-AI）环境变量模板
# =============================================================================
# 使用方法:
#   1. 复制本文件为 .env:        cp .env.example .env
#   2. 填入真实 API Key 等值
#   3. .env 已加入 .gitignore, 不会提交到仓库
#   4. systemd 服务通过 EnvironmentFile=/path/to/.env 加载
#   5. 手动运行时, python-dotenv 会自动从 .env 读取
# =============================================================================

# -----------------------------------------------------------------------------
# 1. LLM 凭据 (必填其一, 否则进入 mock 模式)
# -----------------------------------------------------------------------------
# DeepSeek API Key —— 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=

# 备用: OpenAI 兼容 Key (当 DEEPSEEK_API_KEY 为空时使用)
OPENAI_API_KEY=

# 强制 mock 模式 (1/true/yes 启用, 不调用真实 LLM, 仅返回 stub 回复)
# 部署验证或首次启动时建议开启, 验证链路后再关闭
YUYI_LLM_MOCK=

# -----------------------------------------------------------------------------
# 2. API 服务端口
# -----------------------------------------------------------------------------
# Yuyi API 监听端口 (默认 5000, 与 config.yaml 中 admin 控制台保持一致)
YUYI_API_PORT=5000

# Admin 控制台路径前缀 (默认 /admin)
YUYI_ADMIN_PREFIX=/admin

# Admin 敏感端点（/admin/api/screen/* 与 /admin/api/control/*）访问 token
# 安全修复 2026-08-11：这些端点可读取屏幕内容、远程操作鼠标键盘，已强制鉴权。
#   - 配置后：请求必须携带请求头 X-Admin-Token: <token>（管理面板 JS 会在 401 时提示输入）
#   - 不配置：这些端点仅允许本机回环(127.0.0.1)访问，经 nginx/局域网访问会被 403 拒绝
# 建议使用 32 位以上随机字符串: openssl rand -hex 32
YUYI_ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# 3. 远程模块 / 屏幕监控 (可选)
# -----------------------------------------------------------------------------
# 本地代理连接 token (本地 agent 启动时需要传入相同 token)
# 安全修复 2026-08-11：此变量现在真正生效（此前代码从未读取，只认 config.yaml 硬编码值）。
# 服务端为空或已知弱默认值时 Agent Server 会拒绝启动（fail-closed）。
# 本地代理端可用 YUYI_AGENT_TOKEN 或同名变量传入相同值。
# 建议使用 32 位以上随机字符串: openssl rand -hex 32
YUYI_REMOTE_TOKEN=

# 远程 WebSocket 监听端口 (默认 8765)
YUYI_REMOTE_PORT=8765

# -----------------------------------------------------------------------------
# 4. 主动消息 / OneBot (可选, 不使用主动消息可留空)
# -----------------------------------------------------------------------------
# OneBot HTTP API 地址 (例: http://127.0.0.1:3000)
ONEBOT_URL=http://127.0.0.1:3000

# OneBot Access Token
ONEBOT_TOKEN=

# AstrBot HTTP API 地址 (备用)
ASTRBOT_URL=http://127.0.0.1:11451

# 主动消息目标 QQ
TARGET_USER_QQ=

# 主动消息检查间隔 (秒)
MIN_CHECK_SECONDS=300
MAX_CHECK_SECONDS=900

# -----------------------------------------------------------------------------
# 5. 运行时选项
# -----------------------------------------------------------------------------
# Python 路径 (systemd 单元中可省略, 脚本会自动用当前 python)
PYTHON_BIN=python3

# 日志级别 (DEBUG/INFO/WARNING/ERROR)
YUYI_LOG_LEVEL=INFO

# 数据目录 (默认 ./data)
YUYI_DATA_DIR=./data

# End of .env.example
