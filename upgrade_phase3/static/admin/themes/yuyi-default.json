{
  "name": "yuyi-default",
  "label": "羽依默认",
  "description": "羽依专属主题 — 淡蓝淡紫温柔系",
  "version": "1.0.0",
  "author": "Yuyi",

  "background": {
    "gradient": "linear-gradient(135deg, #f0f4ff 0%, #faf5ff 50%, #fff1f9 100%)",
    "pattern": "none",
    "particle": {
      "enabled": true,
      "count": 30,
      "colors": ["#c4b5fd", "#a5b4fc", "#f9a8d4"],
      "speed": 0.3
    }
  },

  "glass": {
    "card": {
      "background": "rgba(255, 255, 255, 0.65)",
      "border": "rgba(196, 181, 253, 0.25)",
      "blur": "16px"
    },
    "overlay": {
      "background": "rgba(255, 255, 255, 0.80)",
      "border": "rgba(167, 139, 250, 0.35)",
      "blur": "24px"
    }
  },

  "character": {
    "glowColor": "rgba(196, 181, 253, 0.6)",
    "glowIntensity": 1.0,
    "moodOverrides": {
      "calm": { "glowColor": "rgba(165, 180, 252, 0.5)", "hue": 0 },
      "happy": { "glowColor": "rgba(249, 168, 212, 0.6)", "hue": -10 },
      "excited": { "glowColor": "rgba(244, 114, 182, 0.7)", "hue": -15 },
      "sad": { "glowColor": "rgba(148, 163, 184, 0.5)", "hue": 20 },
      "worried": { "glowColor": "rgba(251, 191, 36, 0.5)", "hue": 10 }
    }
  },

  "states": {
    "calm":     { "color": "#6890ff", "soft": "#e0ebff", "glow": "rgba(104, 144, 255, 0.3)" },
    "happy":    { "color": "#f472b6", "soft": "#fce7f3", "glow": "rgba(244, 114, 182, 0.3)" },
    "thinking": { "color": "#a78bfa", "soft": "#ede9fe", "glow": "rgba(167, 139, 250, 0.3)" },
    "notice":   { "color": "#fbbf24", "soft": "#fef3c7", "glow": "rgba(251, 191, 36, 0.3)" },
    "worry":    { "color": "#f87171", "soft": "#fee2e2", "glow": "rgba(248, 113, 113, 0.25)" },
    "growth":   { "color": "#34d399", "soft": "#d1fae5", "glow": "rgba(52, 211, 153, 0.3)" }
  },

  "text": {
    "primary": "#3b3a5a",
    "secondary": "#6b6a8a",
    "muted": "#a09bbf"
  },

  "animation": {
    "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
    "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "duration": {
      "fast": 150,
      "normal": 250,
      "slow": 400
    }
  },

  "sound": {
    "enabled": false,
    "volume": 0.3,
    "effects": {
      "click": "none",
      "notify": "none",
      "emotion_change": "none"
    }
  }
}
