# YUI yuyi-api systemd unit 模板（v0.5.1-t2-ready-full）
# 用法：复制为 /etc/systemd/system/yuyi-api.service 后调整路径
# 敏感值通过 EnvironmentFile 注入，禁止写入本文件
[Unit]
Description=YUI QianWuYuyi API Server
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/QianWuYuyi-AI
# 生产解释器（venv）与启动入口
ExecStart=/root/QianWuYuyi-AI/venv/bin/python /root/QianWuYuyi-AI/api_server.py
# 敏感环境变量（DEEPSEEK_API_KEY / YUYI_REMOTE_TOKEN / ONEBOT_TOKEN / MC_EVENTS_TOKEN 等）
EnvironmentFile=/root/QianWuYuyi-AI/.env
Restart=always
RestartSec=5
User=root
Group=root

[Install]
WantedBy=multi-user.target
